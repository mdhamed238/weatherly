# Weather API Key (required for real data)
WEATHER_API_KEY=your_visual_crossing_api_key_here

# Server configuration (optional)
SERVER_PORT=8080

# Redis configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limiting configuration (optional)
APP_RATE_LIMIT_CAPACITY=20
APP_RATE_LIMIT_REFILL_TOKENS=10
APP_RATE_LIMIT_REFILL_DURATION=1

# Cache configuration (optional)
# 12 hours in milliseconds
APP_CACHE_TIME_TO_LIVE=43200000

# API Key Authentication (optional)
# Set to true to enable API key authentication
# Uses the same WEATHER_API_KEY for authentication
APP_API_KEY_ENABLED=false
